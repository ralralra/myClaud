// ============================================================================
//  [01] 서보 1개 테스트 — 핀 번호만 바꿔서 하나씩 확인하기 (가장 기초)
// ----------------------------------------------------------------------------
//   [사용법]
//     1) 아래 PIN 값을 서보 핀 번호로 바꾼다.
//     2) 업로드(→) 한다.  →  그 서보 하나가 왔다갔다 움직인다.
//     3) 다음 서보를 볼 때는 PIN 숫자만 바꿔 다시 업로드.
//
//   이 로봇팔의 서보 핀:   2  ·  3  ·  9  ·  8  ·  4  ·  5
//        (1번=2, 2번=3, 3번=9, 4번=8, 5번=4, 6번(그리퍼)=5)
// ============================================================================

#include <Servo.h>          // 서보 도구상자

int PIN = 2;                 // ★ 여기 숫자만 바꾼다! (2 → 3 → 9 → 8 → 4 → 5)

Servo myservo;              // 서보 1개

void setup() {
  myservo.attach(PIN);      // PIN 번호에 서보를 연결
}

void loop() {
  // 0도 → 90도 (1도씩 천천히)
  for (int angle = 0; angle <= 90; angle++) {
    myservo.write(angle);   // 서보를 angle 각도로 보낸다
    delay(15);              // 숫자를 키우면 더 천천히 움직인다
  }
  // 90도 → 0도 (다시 돌아오기)
  for (int angle = 90; angle >= 0; angle--) {
    myservo.write(angle);
    delay(15);
  }

  // ※ 그리퍼(6번, 핀 5)는 0~90도가 안전 범위이므로 위 코드를 그대로 쓴다.
  //    1~5번 서보를 더 크게 움직여 보려면 위의 90을 180으로 바꿔도 된다.
}
