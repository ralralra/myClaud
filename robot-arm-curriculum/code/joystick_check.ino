// ============================================================================
//   조이스틱 값 확인하기 — 어떤 조이스틱이 어떤 값을 내는지 보기

// ----------------------------------------------------------------------------
//   [무엇을 하나?]  조이스틱 6개(A0~A5)의 값을 시리얼 모니터에 계속 출력한다.
//   [어떻게 쓰나?]  시리얼 모니터(9600 baud)를 열고, 조이스틱을 '하나씩' 움직이며
//                   어떤 J값이 변하는지 관찰한다. → 활동지 '조이스틱 관찰표'에 기록.
//   [값의 의미]     조이스틱을 안 만지면 약 512(가운데).
//                   한쪽으로 밀면 → 1023 쪽,  반대로 밀면 → 0 쪽.
//                   612보다 크면 ▲(+방향), 412보다 작으면 ▼(-방향), 그 사이는 멈춤.
//   [팁]           Tools → Serial Plotter 를 열면 값이 그래프로 보인다!
// ============================================================================

const int JOYS = 6;                       // 조이스틱(축) 개수
int ANA[JOYS] = { A0, A1, A2, A3, A4, A5 }; // 각 조이스틱이 연결된 아날로그 핀

void setup() {
  Serial.begin(9600);                     // 값을 화면에 보여주려고 통신 시작
  Serial.println("조이스틱 값 확인 시작! 하나씩 움직여 보세요.");
}

void loop() {
  for (int i = 0; i < JOYS; i++) {
    int value = analogRead(ANA[i]);       // i번 조이스틱 값 읽기 (0~1023)

    Serial.print("J");
    Serial.print(i + 1);                  // 사람이 세는 번호(1~6)
    Serial.print(":");
    Serial.print(value);                  // 실제 값

    // 값에 따라 방향 표시 (로봇팔 코드의 612/412 기준과 동일)
    if (value > 612)      Serial.print(" +   ");   // 한쪽 방향
    else if (value < 412) Serial.print(" -   ");   // 반대 방향
    else                  Serial.print(" .   ");   // 가운데(멈춤)
  }

  Serial.println();                       // 한 줄 끝 → 다음 줄로
  delay(200);                             // 0.2초마다 갱신 (숫자를 키우면 느리게)
}
